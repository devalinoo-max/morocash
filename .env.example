# Neon
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/morocash?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/morocash?sslmode=require"

# Sessions
SESSION_SECRET=""              # openssl rand -base64 32
SESSION_MAX_AGE_DAYS="30"

# Cloudinary
# Cloudinary : CLOUDINARY_URL (cloudinary://clé:secret@cloud) suffit et passe en
# priorité ; sinon les trois variables. Attention, la console masque le secret.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMS (récupération du code, relances d'abonnement)
SMS_PROVIDER_URL=""
SMS_PROVIDER_KEY=""
SMS_SENDER_ID="MOROCASH"

# WhatsApp Cloud API — canal du code "PIN oublié". Sans ces deux variables, le
# code part par SMS (repli), et si le SMS n'est pas configuré non plus il est
# seulement journalisé : jamais de fausse réussite silencieuse.
WHATSAPP_TOKEN=""              # SECRET — jeton permanent de l'utilisateur système morocash-api
WHATSAPP_PHONE_NUMBER_ID="1469375619589110"
WHATSAPP_ACCOUNT_ID="1461726619472829"
WHATSAPP_API_VERSION="v25.0"
# Connexion par code et « mot de passe oublié » : modèle Meta déjà approuvé (ne pas le modifier).
WHATSAPP_TEMPLATE_NAME="morocash_code_verification"
WHATSAPP_TEMPLATE_LANG="fr"
# SECRETS — à saisir uniquement dans Vercel / .env local, jamais dans Git.
WHATSAPP_APP_SECRET=""         # developers.facebook.com > l'app > Paramètres > Général > Clé secrète
WHATSAPP_VERIFY_TOKEN=""       # phrase au hasard (openssl rand -hex 24), recopiée dans Meta
OTP_SECRET=""                  # 32 octets au hasard (openssl rand -hex 32), chiffre les codes
# E-mails (code de mot de passe oublié) via Resend. EMAIL_FROM doit être sur un
# domaine vérifié chez Resend, ex. "MoroCash <noreply@ton-domaine.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

# Passerelle de paiement de l'abonnement
# pawaPay (Payment Page). Callbacks à déclarer dans le Dashboard pawaPay :
#   Checkouts : https://morocash.vercel.app/api/v1/payments/pawapay/callback/checkouts
#   Deposits  : https://morocash.vercel.app/api/v1/payments/pawapay/callback
#   Refunds   : https://morocash.vercel.app/api/v1/payments/pawapay/callback/refunds
PAWAPAY_API_URL="https://api.sandbox.pawapay.io"   # prod : https://api.pawapay.io
PAWAPAY_API_TOKEN=""
# Adresse du frontend où pawaPay renvoie le client (sinon : origine du navigateur)
APP_PUBLIC_URL=""
# Adresse publique (https) des liens d'affilié /a/CODE. À défaut : APP_PUBLIC_URL
# si elle est en https, sinon https://morocashfront.vercel.app — jamais localhost.
AFFILIATE_PUBLIC_URL=""

# Tâches planifiées
CRON_SECRET=""                 # openssl rand -hex 32

# Supervision
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
