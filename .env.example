# Neon
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/morocash?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/morocash?sslmode=require"

# Sessions
SESSION_SECRET=""              # openssl rand -base64 32
SESSION_MAX_AGE_DAYS="30"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMS (récupération du code, relances d'abonnement)
SMS_PROVIDER_URL=""
SMS_PROVIDER_KEY=""
SMS_SENDER_ID="MOROCASH"

# WhatsApp Cloud API — canal du code "PIN oublié". Sans ces deux variables, le
# code part par SMS (repli), et si le SMS n'est pas configuré non plus il est
# seulement journalisé : jamais de fausse réussite silencieuse.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Passerelle de paiement de l'abonnement
# pawaPay (Payment Page). Callback à déclarer dans le Dashboard pawaPay :
#   https://morocash.vercel.app/api/v1/payments/pawapay/callback
PAWAPAY_API_URL="https://api.sandbox.pawapay.io"   # prod : https://api.pawapay.io
PAWAPAY_API_TOKEN=""
# Adresse du frontend où pawaPay renvoie le client (sinon : origine du navigateur)
APP_PUBLIC_URL=""

# Tâches planifiées
CRON_SECRET=""                 # openssl rand -hex 32

# Supervision
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
